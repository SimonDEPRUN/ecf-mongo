<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <title>Mise à jour avion</title>
</head>

<body>
  <%- include("../header") %>

  <main class="container">
    <h2 class="text-center">Update avion</h2>
    <form method="POST" action="/api/avion/<%= avion._id %>?_method=PUT">
      <div class="mb-3">
        <label for="model" class="form-label">Modèle : </label>
        <input type="text" value="<%= avion.model %>" name="model" class="form-control" id="model" aria-describedby="emailHelp">
      </div>
      <div class="mb-3">
        <label for="compagnie" class="form-label">Compagnie : </label>
        <input type="text" value="<%= avion.compagnie %>" name="compagnie" class="form-control" id="compagnie">
      </div>

      <div class="mb-3">
        <label for="capacite" class="form-label">Capacité : </label>
        <input type="text" value="<%= avion.capacite %>" name="capacite" class="form-control" id="capacite">
      </div>
      <div class="form-check">
        <input type="checkbox" name="enService" class="form-check-input" id="enService" <%= avion.enService ? "checked" : "" %>>
        <label for="enService" class="form-label">En Service</label>
      </div>
      <button type="submit" class="btn btn-primary">Submit</button>
    </form>
  </main>
</body>

</html>