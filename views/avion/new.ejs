<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <title>Document</title>
</head>

<body>
  <%- include("../header") %>
  <main class="container">
    <h2 class="text-center">New avion</h2>
    <form method="POST" action="/api/avion/?_method=PUT">
      <div class="mb-3">
        <label for="model" class="form-label">Modèle : </label>
        <input type="text" class="form-control" name="model" id="model" aria-describedby="textHelp">
      </div>
      <div class="mb-3">
        <label for="compagnie" class="form-label">Compagnie : </label>
        <input type="text" class="form-control" name="compagnie" id="compagnie">
      </div>
      <div class="mb-3 form-check">
        <label class="form-check-label" for="capacite">Capacité de l'avion</label>
        <input type="number" class="form-control" name="capacite" id="capacite">
      </div>
      <button type="submit" class="btn btn-primary">Submit</button>
    </form>
  </main>
</body>

</html>