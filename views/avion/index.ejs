<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>

<body>
  <%- include("../header") %>
  <main>

    <h1>Avions</h1>

    <% avions.forEach( (avion) => { %>
    <ul>
      <li> Modèle : <%= avion.model %> </li>
      <li> Compagnie : <%= avion.compagnie %> </li>
      <li> Capacité : <%= avion.capacite %> </li>
    </ul>
    <form method="POST" action="/api/avion/<%= avion._id %>?_method=DELETE">
      <button type="submit">Delete</button>
    </form>
    <hr>
    <% }) %>

  </main>
</body>

</html>