<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

  <title>Liste Vols</title>
</head>

<body>
  <%- include("../header") %>
  <main class="container">
    <h1>Vols</h1>

    <% vols.forEach( (vol) => { %>
    <ul>
      <li> Numéro de vol : <%= vol.numero %> </li>
      <li> Date de départ : <%= vol.dateDepart %> </li>
      <li> De : <%= vol.origine %> </li>
      <li> date d'arrivée : <%= vol.dateArrivee %> </li>
      <li> À : <%= vol.destination %> </li>
      <li> Appareil : <%= vol.avionId._id %> </li>
      <li> Compagnie : <%= vol.avionId.compagnie %></li>
      <li> Place disponible : <%= vol.avionId.placeRestantes%></li>
      <li> Status : <%= vol.status %> </li>
    </ul>
    <form method="POST" action="/api/vol/<%= vol._id %>?_method=DELETE" class="d-inline">
      <button type="submit" class="btn btn-outline-primary">Delete</button>
    </form>
    <a href="/api/vol/<%= vol._id %>/update" class="btn btn-outline-primary">Update</a>
    <hr>
    <% }) %>

    <h2>Status des vols</h2>
    <% Object.keys(statusVol).forEach(status => { %>
    <h4><%= status %></h4>
    <h5>Total : <%= statusVol[status].length %> </h5>
    <ul>
      <% statusVol[status].forEach(v => {%>
      <li>Vol n° : <%= v.numero %> en départ de : <%= v.origine %>, à destination de : <%= v.destination %> </li>
      <%}) %>
    </ul>
    <%}) %>
    <h2>Vols par compagnie</h2>
    <% Object.keys(volsParCompagnie).forEach(compagnie => { %>
    <h4><%= compagnie %></h4>
    <h5>Total : <%= volsParCompagnie[compagnie].length %> </h5>
    <ul>
      <% volsParCompagnie[compagnie].forEach(v => {%>
      <li>Vol n° : <%= v.numero %> en départ de : <%= v.origine %>, à destination de : <%= v.destination %> </li>
      <%}) %>
    </ul>
    <%}) %>
    <h2>Vols du mois</h2>
    <h5>Total : <%= volsDuMois.length %></h5>
    <ul>
      <% volsDuMois.forEach(v => { %>
      <li>Vol n° : <%= v.numero %> en départ de : <%= v.origine %>, à destination de : <%= v.destination %> </li>
      <%}) %>
    </ul>
  </main>
</body>

</html>