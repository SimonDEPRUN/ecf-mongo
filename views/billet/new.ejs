<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <title>Document</title>
</head>

<body>
  <%- include("../header") %>
  <main class="container">
    <h2 class="text-center">New billet</h2>
    <form method="POST" action="/api/billet">
      <div class="mb-3">
        <label for="volId" class="form-label">Numéro de vol : </label>
        <select name="volId" class="form-select">
          <% vols.forEach( v => { %>
          <option value="<%= v._id %>"> <%= v.numero %> - <%= v.origine %> - <%= v.destination %> - <%= v.dateDepart %> - <%= v.dateArrivee %> - <%= v.avionId %> - <%= v.status %></option>
          <% }) %>
        </select>
      </div>
      <div class="mb-3">
        <label for="passagerId" class="form-label">Passager ID : </label>
        <select name="passagerId" class="form-select">
          <% passagers.forEach( p => { %>
          <option value="<%= p._id %>"> <%= p.nom %> - <%= p.prenom %> - <%= p.email %> - <%= p.pays %></option>
          <% }) %>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-check-label" for="numeroSiege">Siège : </label>
        <input type="text" class="form-control" name="numeroSiege" id="numeroSiege">
      </div>
      <div class="mb-3">
        <label class="form-check-label" for="classe">Classe : </label>
        <select name="classe" class="form-select">
          <option value="">--Classes--</option>
          <option value="Economie">Eco</option>
          <option value="Affaires">Affaires</option>
          <option value="Premiere">Première</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-check-label" for="prix">Prix : </label>
        <input type="text" class="form-control" name="prix" id="prix">
      </div>
      <div class="mb-3">
        <label class="form-check-label" for="modePaiement">Mode de paiement : </label>
        <select name="modePaiement" class="form-select" id="modePaiement">
          <option value="">--Paiement--</option>
          <option value="CB">Carte Bleu</option>
          <option value="Paypal">Paypal</option>
          <option value="Especes">Especes</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Submit</button>
    </form>
  </main>
</body>

</html>