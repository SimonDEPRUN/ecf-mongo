<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

  <title>Document</title>
</head>

<body>
  <%- include("../header") %>
  <main class="container">
    <h1>Billets</h1>

    <% billets.forEach( (billet) => { %>
    <ul>
      <li> Vol : <%= billet.vilId %> </li>
      <li> Passager : <%= billet.passagerId %> </li>
      <li> Siège <%= billet.numeroSiege %> </li>
      <li> Classe : <%= billet.classe %> </li>
      <li> Date de reservation : <%= billet.dateReservation %> </li>
      <li> Status : <%= billet.statut %> </li>
    </ul>
    <form method="POST" action="/api/billet/<%= billet._id %>?_method=DELETE" class="d-inline">
      <button type="submit" class="btn btn-outline-primary">Delete</button>
    </form>
    <a href="/api/billet/<%= billet._id %>/update" class="btn btn-outline-primary">Update</a>
    <hr>
    <% }) %>

  </main>
</body>

</html>