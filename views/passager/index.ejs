<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

  <title>Document</title>
</head>

<body>
  <%- include("../header") %>
  <main class="container">
    <h1>Passagers</h1>

    <% passagers.forEach( (passager) => { %>
    <ul>
      <li> Nom : <%= passager.nom %> </li>
      <li> Prénom : <%= passager.prenom %> </li>
      <li> Adresse Mail <%= passager.email %> </li>
      <li> Pays : <%= passager.pays %> </li>
      <li> Date d'inscription : <%= passager.dateInscription %> </li>

    </ul>
    <form method="POST" action="/api/passager/<%= passager._id %>?_method=DELETE" class="d-inline">
      <button type="submit" class="btn btn-outline-primary">Delete</button>
    </form>
    <a href="/api/passager/<%= passager._id %>/update" class="btn btn-outline-primary">Update</a>
    <hr>
    <% }) %>

    <h2>Passagers Enregistrée Totaux</h2>
    <h5>Total : <%= passagers.length %></h5>
    <h2>Nouveau passagers du mois</h2>
    <h5>Total : <%= passagersDuMois.length %> </h5>
    <ul>
      <% passagersDuMois.forEach(p => {%>
      <li><%= p.nom%> <%= p.prenom%></li>
      <%}) %>
    </ul>
  </main>
</body>

</html>